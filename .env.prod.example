# =====================================================================
# Modèle de configuration de production.
# Copier ce fichier en .env puis renseigner les valeurs réelles :
#     cp .env.prod.example .env
# Le fichier .env ne doit JAMAIS être versionné (il contient des secrets).
# =====================================================================

# --- Base de données PostgreSQL ---
POSTGRES_USER=rh_user
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-fort
POSTGRES_DB=rh_primature

# --- Sécurité backend ---
# Clé de signature des jetons JWT — 32 caractères minimum, aléatoire.
# Générer par ex. avec :  openssl rand -hex 32
JWT_SECRET_KEY=remplacer-par-une-cle-aleatoire-de-32-caracteres-minimum

# --- Chiffrement PII au repos (Sub-B, loi 037/AN/2016) ---
# OBLIGATOIRE EN PROD : le backend refuse de démarrer si ces clés sont absentes.
# Cf. docs/security/pii_migration_runbook.md pour la procédure complète.
# Format : kvN:<token-fernet-44-chars-base64-urlsafe>, séparés par virgule
# pour la rotation (la première sert à l'écriture, les autres au déchiffrement).
# Génération d'une nouvelle clé :
#   python3 -c 'from cryptography.fernet import Fernet; print("kv1:" + Fernet.generate_key().decode())'
PII_ENCRYPTION_KEYS=kv1:remplacer-par-une-cle-fernet-44-chars-base64-urlsafe=

# Clé HMAC pour les lookups déterministes sur email/national_id (≥ 64 chars hex).
# Génération :  python3 -c 'import secrets; print(secrets.token_hex(32))'
EMAIL_LOOKUP_HMAC_KEY=remplacer-par-une-cle-hmac-64-chars-hexadecimaux

# --- JWT cookies httpOnly (P0 #4) ---
# OBLIGATOIRE EN PROD : les validators Pydantic refusent le boot si Secure=false
# ou si jwt_return_token_in_body=true (cf. docs/security/auth_runbook.md).
JWT_COOKIE_SECURE=true
JWT_RETURN_TOKEN_IN_BODY=false
# Optionnels (défauts OK) — décommentez pour personnaliser :
# JWT_COOKIE_NAME=rh_access
# JWT_REFRESH_COOKIE_NAME=rh_refresh
# JWT_COOKIE_SAMESITE=lax
# JWT_COOKIE_DOMAIN=

# --- Domaine ---
# Origines autorisées (CORS). Mettre l'URL publique de l'application.
ALLOWED_ORIGINS=https://votre-domaine.com

# --- Réseau ---
# Port HTTP exposé par le frontend sur le VPS (80 par défaut).
HTTP_PORT=80

# --- IA / LLM ---
# Provider : mock | groq | anthropic | openai
#   mock  = aucune IA réelle (réponses factices)
#   groq  = API cloud, palier gratuit (recommandé en attendant la validation)
# Clé Groq gratuite : https://console.groq.com (sans carte bancaire).
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_remplacer-par-la-vraie-cle
GROQ_MODEL=llama-3.3-70b-versatile
