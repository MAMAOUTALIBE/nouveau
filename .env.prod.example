# =====================================================================
# Modèle de configuration de production.
# Copier ce fichier en .env puis renseigner les valeurs réelles :
#     cp .env.prod.example .env
# Le fichier .env ne doit JAMAIS être versionné (il contient des secrets).
# =====================================================================

# --- Base de données PostgreSQL ---
POSTGRES_USER=rh_user
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-fort
POSTGRES_DB=rh_primature

# --- Sécurité backend ---
# Clé de signature des jetons JWT — 32 caractères minimum, aléatoire.
# Générer par ex. avec :  openssl rand -hex 32
JWT_SECRET_KEY=remplacer-par-une-cle-aleatoire-de-32-caracteres-minimum

# --- Domaine ---
# Origines autorisées (CORS). Mettre l'URL publique de l'application.
ALLOWED_ORIGINS=https://votre-domaine.com

# --- Réseau ---
# Port HTTP exposé par le frontend sur le VPS (80 par défaut).
HTTP_PORT=80
