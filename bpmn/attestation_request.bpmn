<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    id="attestation_request_definitions"
    targetNamespace="http://primature.gov.gn/bpmn/attestation"
    exporter="manual"
    exporterVersion="1.0">

  <bpmn:process id="ATTESTATION_V1" name="Demande d'attestation administrative" isExecutable="true">

    <bpmn:startEvent id="wf_start" name="Demande soumise">
      <bpmn:outgoing>flow_to_drh</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="wf_drh_review" name="Validation et préparation DRH">
      <bpmn:incoming>flow_to_drh</bpmn:incoming>
      <bpmn:outgoing>flow_drh_to_gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="wf_gateway_drh_decision" name="Décision DRH">
      <bpmn:incoming>flow_drh_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_rejected</bpmn:outgoing>
      <bpmn:outgoing>flow_to_signature</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="wf_signature" name="Signature électronique">
      <bpmn:incoming>flow_to_signature</bpmn:incoming>
      <bpmn:outgoing>flow_signed</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="wf_end_approved" name="Attestation émise">
      <bpmn:incoming>flow_signed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="wf_end_rejected" name="Demande refusée">
      <bpmn:incoming>flow_rejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow_to_drh"
        sourceRef="wf_start" targetRef="wf_drh_review" />
    <bpmn:sequenceFlow id="flow_drh_to_gateway"
        sourceRef="wf_drh_review" targetRef="wf_gateway_drh_decision" />
    <bpmn:sequenceFlow id="flow_rejected"
        sourceRef="wf_gateway_drh_decision" targetRef="wf_end_rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">decision == "REJECT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_to_signature"
        sourceRef="wf_gateway_drh_decision" targetRef="wf_signature">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">decision == "APPROVE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_signed"
        sourceRef="wf_signature" targetRef="wf_end_approved" />

  </bpmn:process>
</bpmn:definitions>
