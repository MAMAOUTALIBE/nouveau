# =====================================================================
# Backend RH Primature — variables d'environnement
# =====================================================================
# Copier en .env et adapter pour le développement local.
# En production : définir TOUTES les variables marquées REQUIS.

# -- Environnement
ENV=dev                                      # dev | staging | prod
LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR
APP_HOST=127.0.0.1
APP_PORT=8000

# -- Sécurité (REQUIS en prod)
JWT_SECRET_KEY=dev-only-change-in-production-please-use-32-bytes-minimum
JWT_ACCESS_TTL_SECONDS=1800                  # 30 min
JWT_REFRESH_TTL_SECONDS=86400                # 24 h
JWT_ALGORITHM=HS256
BCRYPT_ROUNDS=12

# Rate limiting login
RATE_LIMIT_LOGIN_MAX=5                       # tentatives avant lock
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60           # fenêtre de comptage
RATE_LIMIT_LOGIN_LOCK_SECONDS=900            # 15 min de verrouillage

# CORS — liste séparée par virgules
ALLOWED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200

# -- Base de données PostgreSQL (REQUIS)
DATABASE_URL=postgresql+asyncpg://rh_user:rh_password@localhost:5432/rh_primature
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false                                # true = log SQL en dev

# -- Migrations
RUN_MIGRATIONS_ON_STARTUP=false              # true en CI / prod
SCHEMA_NAME=hr

# -- Audit
AUDIT_LOG_REQUEST_BODY=false                 # ne JAMAIS activer en prod (PII)
