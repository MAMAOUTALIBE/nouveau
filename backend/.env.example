# =====================================================================
# Backend RH Primature — variables d'environnement
# =====================================================================
# Copier en .env et adapter pour le développement local.
# En production : définir TOUTES les variables marquées REQUIS.

# -- Environnement
ENV=dev                                      # dev | staging | prod
LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR
APP_HOST=127.0.0.1
APP_PORT=8000

# -- Sécurité (REQUIS en prod)
JWT_SECRET_KEY=dev-only-change-in-production-please-use-32-bytes-minimum
JWT_ACCESS_TTL_SECONDS=1800                  # 30 min
JWT_REFRESH_TTL_SECONDS=86400                # 24 h
JWT_ALGORITHM=HS256
BCRYPT_ROUNDS=12

# Rate limiting login
RATE_LIMIT_LOGIN_MAX=5                       # tentatives avant lock
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60           # fenêtre de comptage
RATE_LIMIT_LOGIN_LOCK_SECONDS=900            # 15 min de verrouillage

# CORS — liste séparée par virgules
ALLOWED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200

# -- Base de données PostgreSQL (REQUIS)
DATABASE_URL=postgresql+asyncpg://rh_user:rh_password@localhost:5432/rh_primature
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false                                # true = log SQL en dev

# -- Migrations
RUN_MIGRATIONS_ON_STARTUP=false              # true en CI / prod
SCHEMA_NAME=hr

# -- Audit
AUDIT_LOG_REQUEST_BODY=false                 # ne JAMAIS activer en prod (PII)

# -- Chiffrement PII (REQUIS en staging/prod)
# Génération clé Fernet : python -c "from cryptography.fernet import Fernet; print('kv1:' + Fernet.generate_key().decode())"
PII_ENCRYPTION_KEYS=
# Génération HMAC : python -c "import secrets; print(secrets.token_hex(32))"
EMAIL_LOOKUP_HMAC_KEY=

# -- IA / LLM
# Provider : mock | ollama | groq | anthropic | openai
#   ollama    = LLM local gratuit et souverain (données sur la machine)
#   groq      = API cloud, palier GRATUIT, modèles Llama 70B rapides
#   anthropic = Claude (qualité supérieure, payant) — après validation
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b                         # modèle Ollama ; claude-opus-4-7 si anthropic
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Groq — clé gratuite sur console.groq.com (sans carte bancaire)
# GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic / OpenAI — mode payant
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
